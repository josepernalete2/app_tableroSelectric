// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoElemento {
  TABLERO
  SUBESTACION
  TRANSFORMADOR
  GENERADOR
  PUESTA_TIERRA
  TRANSFER
  OTRO
}

model Empresa {
  id                  String             @id @default(uuid())
  nombre              String
  rif                 String             @unique
  direccionFiscal     String
  direccion           String?
  gerente1Nombre      String?
  gerente1Telefono    String?
  gerente1Email       String?
  gerente2Nombre      String?
  gerente2Telefono    String?
  gerente2Email       String?
  proyectos           Proyecto[]
  elementosUnifilares ElementoUnifilar[]
  subestaciones       Subestacion[]
  tableros            Tablero[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("empresas")
}

model Proyecto {
  id                  String             @id @default(uuid())
  nombre              String
  direccion           String
  descripcion         String?
  empresaId           String
  empresa             Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  responsableNombre   String?
  responsableTelefono String?
  responsableEmail    String?
  subestaciones       Subestacion[]
  alimentadores       Alimentador[]
  tableros            Tablero[]
  elementosUnifilares ElementoUnifilar[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("proyectos")
}

model ElementoUnifilar {
  id                     String       @id @default(uuid())
  nombre                 String
  tipoElemento           TipoElemento
  ubicacion              String?
  alimentadoPor          String?
  foto                   String?
  observacionesGenerales String?
  datosTecnicos          Json

  // Relaciones
  proyectoId             String
  proyecto               Proyecto     @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  empresaId              String?
  empresa                Empresa?     @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([empresaId])
  @@map("elementos_unifilares")
}

model Subestacion {
  id                 String   @id
  nombre             String   // Nombre o código de la subestación
  ubicacion          String   // Ubicación física
  fecha              String
  hora               String
  inspector          String
  nivelTension       String   // Nivel de tensión (kV)

  // Bloques de evaluación visual estructurada como JSON nativo de PostgreSQL
  estadoEntorno      Json
  obrasCiviles       Json
  equiposPrincipales Json
  puestaTierra       Json
  edificioControl    Json

  firmaInspector     String?
  firmaSupervisor    String?

  // Relaciones
  proyectoId         String
  proyecto           Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  empresaId          String?
  empresa            Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([empresaId])
  @@map("inspecciones_subestacion")
}

model Alimentador {
  id               String    @id @default(uuid())
  nombre           String
  origen           String?
  capacidadAmperios Float?
  proyectoId       String
  proyecto         Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tableros         Tablero[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("alimentadores")
}

model Tablero {
  id            String     @id @default(uuid())
  nombre        String
  ubicacion     String?
  maxPolos      Int        @default(42)
  tension       String?
  fases         Int        @default(3)
  alimentadorId String?
  alimentador   Alimentador? @relation(fields: [alimentadorId], references: [id], onDelete: SetNull)
  circuitos     Circuito[]
  proyectoId    String
  proyecto      Proyecto   @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  empresaId     String?
  empresa       Empresa?   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("tableros")
}

model Circuito {
  id           String   @id @default(uuid())
  tableroId    String
  tablero      Tablero  @relation(fields: [tableroId], references: [id], onDelete: Cascade)
  posicionPolo Int
  numPolos     Int      @default(1)
  amperaje     Float?
  descripcion  String?
  estado       String   @default("ACTIVO") // "ACTIVO", "RESERVA", "DISPONIBLE"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("circuitos")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("WORKER") // ADMIN, WORKER, CLIENT
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Message {
  id             String   @id @default(uuid())
  senderId       String
  senderUsername String
  receiverId     String
  text           String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("messages")
}
