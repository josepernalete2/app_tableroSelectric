# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA - APP TABLEROS SELECTRIC
# ==============================================================================

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/inspecciones?schema=public"

# Servidor Backend
PORT=3001
NODE_ENV=development
JWT_SECRET="supersecreto123456789_tableros_electric_2026_seguro"

# Origen permitido para CORS y WebSockets (Frontend Vite)
CLIENT_URL="http://localhost:5173"

# Notificaciones Web Push (VAPID)
VAPID_SUBJECT="mailto:soporte@selectric.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VITE_VAPID_PUBLIC_KEY=""

# ==============================================================================
# RESPALDOS HÍBRIDOS (Vercel Serverless / Railway Containers)
# ==============================================================================

# Cloudflare R2 (Almacenamiento de Objetos compatible con AWS S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tableros-backups

# Notificaciones y Despacho Inmediato por Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token de Seguridad para Vercel Cron Jobs y Webhooks externos
# Enviar en cabecera: "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
